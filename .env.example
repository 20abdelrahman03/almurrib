# Almurrib configuration — copy to ".env" and fill in. ".env" is git-ignored.
# NEVER commit your real API key. Keys are BYO (Bring Your Own Key).

# Which provider implementation to use. Currently: openai_compat
ALMURRIB_PROVIDER=openai_compat

# Any OpenAI-compatible endpoint works. Presets (see providers/factory.py):
#   openai      https://api.openai.com/v1
#   openrouter  https://openrouter.ai/api/v1
#   gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   kimi        https://api.moonshot.ai/v1
#   llamacpp    http://localhost:8080/v1        (future local path)
ALMURRIB_BASE_URL=https://api.openai.com/v1

# Model id understood by your endpoint, e.g. gpt-4o-mini, gemini-2.0-flash,
# qwen-2.5-72b-instruct, moonshot-v1-8k, ...
ALMURRIB_MODEL=gpt-4o-mini

# Your API key. Required for real translation; leave empty to stay offline.
ALMURRIB_API_KEY=

# Languages (target_lang doubles as the Ren'Py tl/<lang> directory name)
ALMURRIB_SOURCE_LANG=en
ALMURRIB_TARGET_LANG=arabic

# Behaviour
ALMURRIB_BATCH_SIZE=20
ALMURRIB_TIMEOUT_SECONDS=60
ALMURRIB_MAX_RETRIES=3

# Paths
ALMURRIB_DATABASE=almurrib.db
ALMURRIB_OUTPUT_DIR=out

# Set to 1 to enable live-API tests (they are skipped by default).
# ALMURRIB_RUN_LIVE_TESTS=1

# Translation memory: 1 allows machine translations to be reused across
# different provider/model runs; 0 (default) reuses machine TM only for the
# same provider:model that produced it. Human/imported work is always reusable.
# ALMURRIB_REUSE_MACHINE_TM=0
