# Almurrib configuration - copy to ".env" and fill in. ".env" is git-ignored.
# NEVER commit your real API key. Keys are BYO (Bring Your Own Key).
#
# Precedence (highest first): CLI flags / explicit overrides >
# environment variables (ALMURRIB_*) > this .env file > built-in defaults.

# Provider id from the registry (see docs/PROVIDERS.md): openai,
# openrouter, tokenrouter, agentrouter, gemini, deepseek, groq, together,
# fireworks, deepinfra, cerebras, sambanova, mistral, xai, huggingface,
# cohere (native), ollama / llamacpp / vllm / nim (local), openai_compat
# (legacy id for any custom OpenAI-compatible URL).
ALMURRIB_PROVIDER=openrouter

# API root WITHOUT any endpoint suffix (the app appends /chat/completions,
# /models, ... itself). GUI provider selection fills this automatically.
ALMURRIB_BASE_URL=https://openrouter.ai/api/v1

# Model id understood by your endpoint. Prefer GUI Refresh Models over
# typing ids by hand; any string is accepted (manual fallback for local,
# private or brand-new models).
ALMURRIB_MODEL=qwen/qwen3-30b-a3b:free

# Your API key. Required for real translation; leave empty to stay offline.
ALMURRIB_API_KEY=

# Languages (target_lang doubles as the Ren'Py tl/<lang> directory name)
ALMURRIB_SOURCE_LANG=en
ALMURRIB_TARGET_LANG=ar

# Behaviour
ALMURRIB_BATCH_SIZE=20
ALMURRIB_TIMEOUT_SECONDS=60
ALMURRIB_MAX_RETRIES=3

# Paths (relative paths resolve to the working directory for the CLI,
# next to Almurrib.exe for the packaged GUI)
ALMURRIB_DATABASE=almurrib.db
ALMURRIB_OUTPUT_DIR=out

# Set to 1 to enable live-API tests (they are skipped by default).
# ALMURRIB_RUN_LIVE_TESTS=1

# Translation memory: 1 allows machine translations to be reused across
# different provider/model runs; 0 (default) reuses machine TM only for the
# same provider:model that produced it. Human/imported work is always reusable.
# ALMURRIB_REUSE_MACHINE_TM=0

# Interface language: en (LTR) or ar (RTL). Applies to the GUI.
# ALMURRIB_UI_LANG=en
